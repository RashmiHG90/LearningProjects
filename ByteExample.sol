pragma solidity ^0.8.0;

contract ByteExample{
    //Fixed-size byte arrays
    bytes1 public b1=0x11;          //1 byte
    bytes2 public b2=0x1122;        //2 bytes
    bytes3 public b3=0x112233;      //3 bytes
    bytes4 public b4=0x11223344;    //4 bytes
    bytes5 public b5=0x1122334455;  //5 bytes
}